API_PORT=8000
WEB_PORT=3000

# Secret Keys
SECRET_KEY=development-only-change-this-secret-key
SECRET_ENCRYPTION_KEY=
POSTGRES_PASSWORD=rpanexuspassword

# Chave de licença recebida por e-mail após a compra em https://nexusorchestrator.com.
# Pode deixar em branco e ativar depois pela tela de Billing do próprio app.
LICENSE_KEY=

# Database Configuration (opcional; defaults já funcionam)
POSTGRES_USER=rpanexus
POSTGRES_DB=rpanexus_db

# CORS Configuration
CORS_ORIGINS=["http://192.168.15.105:3000"]

# Package Storage
STORAGE_PACKAGE_PATH="/data/packages"
STORAGE_EXECUTION_ARTIFACT_PATH="/storage/execution-artifacts"
STORAGE_ACADEMY_UPLOAD_PATH="/storage/academy-uploads"

# Public API and Web App URLs
# Mesma máquina (192.168.15.105), portas diferentes: 8000=API, 3000=Web.
# CORS_ORIGINS acima deve sempre incluir a origem usada em NEXUS_PUBLIC_WEB_URL.
NEXUS_PUBLIC_API_URL=http://192.168.15.105:8000
NEXUS_PUBLIC_WEB_URL=http://192.168.15.105:3000
NEXUS_WEBHOOK_BASE_URL=http://192.168.15.105:8000

# Domínio do central (não altere, salvo orientação do suporte).
LICENSE_SERVER_URL=https://api.nexusorchestrator.com.br
CENTRAL_APP_URL=https://app.nexusorchestrator.com.br

# Optional AI copilot. Leave blank to keep AI features disabled.
# Gemini (Google AI Studio) via the OpenAI-compatible endpoint:
#   AI_API_KEY=<chave-do-google-ai-studio>
#   AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-flash-latest
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_LOG_CHARS=24000

# Email Management (optional; leave blank to disable email sending in self-hosted mode)
# SMTP_FROM_EMAIL must be on a domain verified in Resend, otherwise sending fails with 422.
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# === Avançado ===
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=57671680

# Frontend build variables, used only by the production web image (docker-entrypoint.cjs).
VITE_API_BASE_URL=http://192.168.15.105:8000
