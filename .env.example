# === Obrigatório ===
# Gere valores aleatórios fortes (ex: `openssl rand -hex 32`) e nunca reutilize os do modo dev.
SECRET_KEY=
SECRET_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Chave de licença recebida por e-mail após a compra em https://nexusorchestrator.com.
# Pode deixar em branco e ativar depois pela tela de Billing do próprio app.
LICENSE_KEY=

# === URLs públicas ===
# Endereço público desta instância (usado para gerar links de instalação do Agent, etc.)
NEXUS_PUBLIC_WEB_URL=http://localhost:3000
NEXUS_PUBLIC_API_URL=http://localhost:8000
# Host dedicado para status_url de webhooks de triggers (opcional; usa NEXUS_PUBLIC_WEB_URL se vazio).
NEXUS_WEBHOOK_BASE_URL=
# Domínio do central (não altere, salvo orientação do suporte).
LICENSE_SERVER_URL=https://nexus-api-production-0e03.up.railway.app
CENTRAL_APP_URL=https://app.nexusorchestrator.com.br

# === Portas locais (opcional) ===
API_PORT=8000
WEB_PORT=3000

# === Banco de dados (opcional, defaults já funcionam) ===
POSTGRES_USER=rpanexus
POSTGRES_DB=rpanexus_db

# === CORS ===
# Liste aqui a(s) origem(ns) usada(s) para acessar o Web App.
CORS_ORIGINS=["http://localhost:3000"]

# === E-mail (opcional, mas recomendado para notificações de cobrança/convites) ===
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Nexus

# === Avançado ===
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=57671680
