ENVIRONMENT=production
SELF_HOSTED_MODE=true
API_PORT=8000
PLATFORM_PORT=3000


# Secret Keys (required: generate unique values before starting)
SECRET_KEY=
SECRET_ENCRYPTION_KEY=


# Database Configuration
POSTGRES_PORT=5432
POSTGRES_HOST=nexus_orchestrator_selfhosted_production_db
POSTGRES_USER=rpanexus
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=rpanexus_db
DATABASE_URL=postgresql+psycopg2://rpanexus:replace-with-a-strong-database-password@nexus_orchestrator_selfhosted_production_db:5432/rpanexus_db


# Advanced (the Compose file injects the internal Redis URL)
REDIS_HOST=nexus_orchestrator_selfhosted_production_redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://nexus_orchestrator_selfhosted_production_redis:6379/0

RATE_LIMIT_PREFIX=nexus:rate-limit
MAX_REQUEST_BYTES=57671680
TRUST_PROXY_HEADERS=false


# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]


# Package Storage
STORAGE_PACKAGE_PATH=/storage/packages
STORAGE_EXECUTION_ARTIFACT_PATH=/storage/execution-artifacts
# Academy, Admin and Stripe belong to the Cloud and are not part of this package.

# Public service URLs
# API/platform URLs are the addresses users use to reach this installation.
# Public documentation, support and community remain on the official site.
NEXUS_PUBLIC_API_URL=http://localhost:8000
NEXUS_PUBLIC_SITE_URL=https://www.nexusorchestrator.com.br
NEXUS_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXUS_WEBHOOK_BASE_URL=http://localhost:8000
VITE_SITE_URL=https://www.nexusorchestrator.com.br


# Agent Configuration
AGENT_RELEASE_PATH=/releases
AGENT_RELEASE_PUBLIC_KEY_PATH=/release-trust/agent-public.key


# Nexus SDK Configuration
NEXUS_SDK_RUNTIME_MIN=0.4.0
NEXUS_SDK_VERSION=0.4.24


# AI Configuration
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_GENERATION_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_LOG_CHARS=24000


# Email Management
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15


LICENSE_SERVER_URL=https://api.nexusorchestrator.com.br
LICENSE_KEY=

# Frontend runtime variables for the production platform image.
# This package serves only the authenticated platform, login and registration.
VITE_API_BASE_URL=http://localhost:8000
VITE_SITE_URL=https://nexusorchestrator.com.br
VITE_PLATFORM_URL=http://localhost:3000