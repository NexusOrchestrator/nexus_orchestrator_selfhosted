ENVIRONMENT=production
API_PORT=8000
WEB_PORT=3000


# Secret Keys (required: generate unique values before starting)
SECRET_KEY=
SECRET_ENCRYPTION_KEY=


# Database Configuration
POSTGRES_PORT=5432
POSTGRES_HOST=nexus_orchestrator_selfhosted_production_db
POSTGRES_USER=rpanexus
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=rpanexus_db
DATABASE_URL=postgresql+psycopg2://rpanexus:replace-with-a-strong-database-password@nexus_orchestrator_selfhosted_production_db:5432/rpanexus_db


# Advanced (the Compose file injects the internal Redis URL)
REDIS_HOST=nexus_orchestrator_selfhosted_production_redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://nexus_orchestrator_selfhosted_production_redis:6379/0

RATE_LIMIT_PREFIX=nexus:rate-limit
MAX_REQUEST_BYTES=57671680
TRUST_PROXY_HEADERS=false


# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]


# Package Storage
STORAGE_PACKAGE_PATH=/storage/packages
STORAGE_EXECUTION_ARTIFACT_PATH=/storage/execution-artifacts
STORAGE_ACADEMY_UPLOAD_PATH=/storage/academy-uploads


# Billing/licensing
# Self-hosted billing is handled by the central license server. Do not put
# Stripe secret keys in this file. STRIPE_SIMULATION is explicitly false so
# production configuration validation cannot accidentally enable simulation.
STRIPE_SIMULATION=false
LICENSE_KEY=

# Public API and Web App URLs
# Set these URLs to the address users will use to reach this installation.
# Example for a local installation: localhost:8000 / localhost:3000.
# CORS_ORIGINS acima deve sempre incluir a origem usada em NEXUS_PUBLIC_WEB_URL.
NEXUS_PUBLIC_API_URL=http://localhost:8000
NEXUS_PUBLIC_WEB_URL=http://localhost:3000
NEXUS_WEBHOOK_BASE_URL=http://localhost:8000


# Agent Configuration
AGENT_RELEASE_PATH=/releases
AGENT_RELEASE_PUBLIC_KEY_PATH=/release-trust/agent-public.key


# Nexus SDK Configuration
NEXUS_SDK_RUNTIME_MIN=0.4.0
NEXUS_SDK_VERSION=0.4.22


# AI Configuration
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_GENERATION_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_LOG_CHARS=24000


# Email Management
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15


LICENSE_SERVER_URL=https://api.nexusorchestrator.com.br

# Frontend build variables, used by the production web image.
VITE_API_BASE_URL=http://localhost:8000
VITE_CENTRAL_APP_URL=https://app.nexusorchestrator.com.br